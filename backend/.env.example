ENV=local

DATABASE_URL=postgresql+asyncpg://neurodesk:neurodesk@localhost:5432/neurodesk
DATABASE_SSL_MODE=disable
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=3

CORS_ORIGINS=http://localhost:3000

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me-to-a-generated-fernet-key
# Leave GOOGLE_CLIENT_ID/MICROSOFT_CLIENT_ID + secret empty to keep the mock OAuth flow.
# Redirect URIs to register in each console:
#   {OAUTH_REDIRECT_BASE_URL}/api/v1/email/{gmail,outlook}/callback
#   {OAUTH_REDIRECT_BASE_URL}/api/v1/auth/google/callback  (Sign in with Google, reuses the Google client above)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

MINIO_ENDPOINT_URL=http://localhost:9000
# Use http://10.0.2.2:9000 for Android emulator upload URLs.
MINIO_PUBLIC_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=neurodesk
MINIO_SECRET_KEY=neurodesk12345
MINIO_BUCKET_NAME=neurodesk-files

# LLM_PROVIDER=mock keeps deterministic local behavior.
# Set LLM_PROVIDER=openai and LLM_API_KEY for OpenAI-compatible Chat Completions.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_ANALYSIS_MODEL=gpt-4o-mini
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_STT_MODEL=whisper-1
LLM_TTS_MODEL=tts-1
LLM_TTS_VOICE=alloy
LLM_TIMEOUT_SECONDS=30

# EMAIL_PROVIDER=mock keeps deterministic local behavior (no real email sent).
# Set EMAIL_PROVIDER=smtp and the SMTP_* values below to send real notification emails.
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
